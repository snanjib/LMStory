<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->

<!-- Splash background aligned with the app's default appearance (classic
     structure + classic palette), light variant: lightBg = #F4F5F7. The
     single source of truth is
     lib/core/theme/system/palettes/classic/classic_palette.dart, kept in
     sync by test/core/theme/t10_android_window_bg_guard_test.dart.

     Previously this was always @android:color/white with no dark variant,
     so a cold start in dark mode flashed a white screen. The dark variant
     lives in res/drawable-night/launch_background.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#F4F5F7" />
    </item>

    <!-- You can insert your own image assets here -->
    <!-- <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item> -->
</layer-list>
